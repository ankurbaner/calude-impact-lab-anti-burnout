{
  "name": "anti-burnout-tracker",
  "version": "0.1.0",
  "description": "A privacy-first screen-time tracker that counts real active time and shows a short recovery card. The only OS input is idle-vs-active — it never reads, records, or screenshots your screen. Cards come from a built-in exercise library, or optionally from Claude when you enable it and supply a key.",
  "author": "Guillermo Motze Espina",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "icons": "node tools/make-tray-icon.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.motze.antiburnout",
    "productName": "Anti-Burnout",
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": "dmg",
      "LSUIElement": true
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  }
}
